#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if (pid > 0) {
        // Parent process
        printf("Parent: My PID is %d\n", getpid());
        printf("Parent: Exiting now, leaving child orphaned.\n");
        exit(0);  // Parent exits first
    } 
    else if (pid == 0) {
        // Child process
        sleep(5);  // Child runs after parent exits
        printf("Child: My parent PID is now %d\n", getppid());
    } 
    else {
        perror("fork");
    }

    return 0;
}
