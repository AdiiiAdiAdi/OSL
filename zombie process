#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if (pid > 0) {
        // Parent process
        printf("Parent: My child PID is %d\n", pid);
        printf("Parent: Sleeping to keep child a zombie...\n");
        sleep(10);  // Parent sleeps, child exits early
        printf("Parent: Now exiting.\n");
    } 
    else if (pid == 0) {
        // Child process
        printf("Child: Exiting now.\n");
        exit(0);  // Child ends immediately
    } 
    else {
        perror("fork");
    }

    return 0;
}
